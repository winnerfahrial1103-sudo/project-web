{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__path=/api/$1" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js?__path=/uploads/$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/payment", "destination": "/index.html" },
    { "source": "/pay", "destination": "/index.html" },
    { "source": "/payment/(.*)", "destination": "/index.html" },
    { "source": "/produk", "destination": "/index.html" },
    { "source": "/katalog", "destination": "/index.html" },
    { "source": "/list", "destination": "/index.html" },
    { "source": "/produk/(.*)", "destination": "/index.html" },
    { "source": "/katalog/(.*)", "destination": "/index.html" },
    { "source": "/order", "destination": "/index.html" }
  ]
}
